<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MauiApp1"
             x:Class="MauiApp1.MainPage"
             x:DataType="viewmodel:MainPageViewModel"
             Title="MauiApp1">

    <VerticalStackLayout>
        <Image Source="cool_pixel_pizza.png"
               HeightRequest="300"
               Aspect="AspectFit"/>
        
        <Label Text="{Binding LabelText}"
               FontSize="24"
               HorizontalTextAlignment="Center"/>
        
        <Button x:Name="ChangeLabelButton"
                Text="{Binding ButtonName}"
                Command="{Binding ChangeButtonCommand}"
                Margin="10"/>
        
        <Entry Placeholder="Add Character"
               Text="{Binding EntryText}"/>

        <Button x:Name="AddButton"
                Text="Add"
                Command="{Binding GetDetailsCommand}"/>

    </VerticalStackLayout>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
